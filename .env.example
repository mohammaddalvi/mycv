# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/website
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Public URL of the site, no trailing slash (used for SEO, sitemap, links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Blob token for file uploads in production (leave empty to store files on local disk)
BLOB_READ_WRITE_TOKEN=
